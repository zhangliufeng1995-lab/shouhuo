{
  "mcpServers": {
    "godot": {
      "command": "node",
      "args": [
        "H:/game/godot-mcp/build/index.js"
      ],
      "transportType": "stdio",
      "disabled": false,
      "timeout": 60,
      "env": {
        "GODOT_PATH": "h:/game/Godot_v4.6.2-stable_win64/Godot_v4.6.2-stable_win64.exe"
      },
      "autoApprove": [
        "launch_editor",
        "run_project",
        "get_debug_output",
        "stop_project",
        "get_godot_version",
        "list_projects",
        "get_project_info",
        "create_scene",
        "add_node",
        "load_sprite",
        "export_mesh_library",
        "save_scene",
        "get_uid",
        "update_project_uids"
      ]
    }
  }
}
